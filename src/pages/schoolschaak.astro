---
import BaseLayout from '../layouts/BaseLayout.astro';
import pagesData from '../data/pages.json';

const page = pagesData['schoolschaak'];
---

<BaseLayout
  title="Schoolschaak – Pentachess"
  bodyClass="page-template-default page page-id-172 custom-background wp-custom-logo wp-embed-responsive singular missing-post-thumbnail has-no-pagination not-showing-comments show-avatars footer-top-visible"
>
  <article class="post-172 page type-page status-publish hentry" id="post-172">
    <header class="entry-header has-text-align-center header-footer-group">
      <div class="entry-header-inner section-inner medium">
        <h1 class="entry-title">{page.title}</h1>
      </div>
    </header>

    <div class="post-inner thin">
      <div class="entry-content" set:html={page.content} />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .wp-embed-aspect-16-9 .wp-block-embed__wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    max-width: 100%;
  }
  .wp-embed-aspect-16-9 .wp-block-embed__wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
