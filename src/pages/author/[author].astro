---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArticle from '../../components/PostArticle.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const authorMap: Record<string, { name: string; posts: CollectionEntry<'posts'>[] }> = {
    admin: { name: 'Wouter de Bruin', posts: [] },
    heppinga: { name: 'Herbert Eppinga', posts: [] },
    mklein: { name: 'Marcel Klein', posts: [] },
    redactie: { name: 'Redactie', posts: [] }
  };

  for (const post of sortedPosts) {
    const slug = post.data.authorSlug;
    if (authorMap[slug]) {
      authorMap[slug].posts.push(post);
    } else {
      authorMap[slug] = {
        name: post.data.author,
        posts: [post]
      };
    }
  }

  return Object.entries(authorMap).map(([authorSlug, { name, posts }]) => ({
    params: { author: authorSlug },
    props: {
      authorName: name,
      authorSlug,
      posts
    }
  }));
}

interface Props {
  authorName: string;
  authorSlug: string;
  posts: CollectionEntry<'posts'>[];
}

const { authorName, authorSlug, posts } = Astro.props;
---

<BaseLayout
  title={`${authorName}, auteur bij Pentachess`}
  bodyClass={`archive author author-${authorSlug} custom-background wp-custom-logo wp-embed-responsive hfeed has-no-pagination showing-comments show-avatars footer-top-visible`}
>
  <header class="archive-header has-text-align-center header-footer-group">
    <div class="archive-header-inner section-inner medium">
      <h1 class="archive-title"><span class="color-accent">Auteur: </span>{authorName}</h1>
    </div>
  </header>

  {posts.map((post, idx) => (
    <>
      <PostArticle post={post} isSingle={false} />
      {idx < posts.length - 1 && (
        <hr class="post-separator styled-separator is-style-wide section-inner" aria-hidden="true" />
      )}
    </>
  ))}
</BaseLayout>
