---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import Button from '../components/Button.astro';
import {
  calendarEvents2026_2027,
  calendarEvents2025_2026,
  viertallenStandings,
} from '../data/tournaments';
---

<BaseLayout title="Jeugdtoernooien & Competities – Pentachess">
  <!-- 1. Hero Section -->
  <HeroSection
    title="Jeugdtoernooien & Competities"
    subtitle="Ontdek de magie van het schaakspel via onze regionale viertallencompetitie, Grand Prix toernooien en online toernooitjes."
    primaryCtaText="Bekijk Speelschema 2026-2027"
    primaryCtaHref="#kalender"
    secondaryCtaText="Einduitslagen Vorig Seizoen"
    secondaryCtaHref="#uitslagen"
    imageSrc="/images/redesign/hero-toernooien.png"
    imageAlt="Kinderen vieren feest met een gouden trofee en schaakbord"
  />

  <!-- 2. Section: Voorlopige Speeldata 2026-2027 -->
  <section class="section" id="kalender">
    <div class="container-narrow">
      <div class="section-header-block">
        <span class="section-badge">Seizoen 2026-2027</span>
        <h2 class="section-title">Voorlopige Speeldata & Locaties</h2>
        <p class="section-intro">
          Stichting Pentachess stimuleert jeugdschaken in de regio Dordrecht, Sliedrecht, Papendrecht, Gorinchem tot Vijfheerenlanden! Hieronder vind je de speelkalender voor het nieuwe seizoen.
        </p>
      </div>

      <!-- Information Callout Box -->
      <div class="info-callout surface-card">
        <div class="info-callout-icon" aria-hidden="true">ℹ️</div>
        <div class="info-callout-content">
          <h3 class="info-callout-title">Regio Teamcompetitie Viertallen</h3>
          <ul class="info-callout-list">
            <li><strong>Tijden:</strong> Aanwezig om <strong>18:45 uur</strong>, start wedstrijden om <strong>19:00 uur</strong>, prijsuitreiking om <strong>20:45 uur</strong>.</li>
            <li><strong>Teams:</strong> Teams bestaan uit 4 jeugdspelers per team.</li>
            <li><strong>Deelname:</strong> Deelname is <strong>volledig gratis</strong>.</li>
            <li><strong>Aanmelden:</strong> Schrijf je in via je eigen jeugdleider van je schaakclub!</li>
          </ul>
          <div class="info-callout-action">
            <Button href="/nieuws/aankondiging-regiocompetitie-2026-2027/" variant="primary" size="sm" showArrow={true}>
              Lees de officiële aankondiging
            </Button>
          </div>
        </div>
      </div>

      <!-- 2026-2027 Calendar Events Stack -->
      <div class="calendar-stack">
        {calendarEvents2026_2027.map((ev) => (
          <div class="calendar-row">
            <div class="calendar-row-left">
              <span class={`event-badge badge-${ev.badgeColor}`}>{ev.badge}</span>
              <div class="event-details">
                <span class="event-title">
                  <strong>{ev.dateLabel} – {ev.title}</strong>
                </span>
                {ev.location && (
                  <span class="event-location">
                    <span class="loc-icon" aria-hidden="true">📍</span> {ev.location}
                  </span>
                )}
              </div>
            </div>
            <div class="calendar-row-right">
              <a
                href={ev.href}
                class="btn btn-secondary btn-sm"
                {...(ev.isExternal || ev.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {ev.ctaLabel}
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Online Toernooitjes Banner -->
      <div class="online-banner surface-card">
        <div class="online-banner-content">
          <span class="online-banner-badge">Online Schaken</span>
          <h3 class="online-banner-title">Elke 1e Woensdagavond van de Maand</h3>
          <p class="online-banner-text">
            In 2027 wordt er maandelijks online geschaakt van <strong>19:00 tot 20:10 uur</strong>. Meld je gratis aan bij team Pentachess op Lichess en speel mee vanaf je tablet of computer!
          </p>
        </div>
        <div class="online-banner-action">
          <a
            href="https://lichess.org/team/pentachess"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            Speel mee op Lichess ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Section: Einduitslagen Viertallencompetitie 2025-2026 -->
  <section class="section section-alt" id="uitslagen">
    <div class="container-narrow">
      <div class="surface-card results-card">
        <span class="section-badge center-badge">Seizoen 2025-2026</span>
        <h2 class="results-heading">Einduitslagen Viertallencompetitie</h2>

        <div class="results-split">
          <!-- Left: Visual Podium -->
          <div class="podium-wrapper">
            <svg viewBox="0 0 320 250" width="300" height="235" xmlns="http://www.w3.org/2000/svg" aria-label="Podium 1e Giessen en Linge 1, 2e Sliedrecht 1, 3e Giessen en Linge 2">
              <!-- 2nd Place Green Pawn (Left) -->
              <circle cx="72" cy="92" r="14" fill="#4CAF50" stroke="#1A202C" stroke-width="3" />
              <path d="M56 145 C58 118 64 108 72 108 C80 108 86 118 88 145 Z" fill="#4CAF50" stroke="#1A202C" stroke-width="3" />
              <rect x="50" y="142" width="44" height="8" rx="4" fill="#3d9140" stroke="#1A202C" stroke-width="3" />

              <!-- 1st Place Gold Trophy (Center) -->
              <path d="M134 32 H186 V56 C186 74 172 86 160 86 C148 86 134 74 134 56 Z" fill="#F59E0B" stroke="#1A202C" stroke-width="3" />
              <path d="M134 40 H122 C122 56 128 62 136 62" fill="none" stroke="#1A202C" stroke-width="3" stroke-linecap="round" />
              <path d="M186 40 H198 C198 56 192 62 184 62" fill="none" stroke="#1A202C" stroke-width="3" stroke-linecap="round" />
              <polygon points="160,42 163,50 171,50 165,55 167,63 160,58 153,63 155,55 149,50 157,50" fill="#FEF3C7" stroke="#1A202C" stroke-width="1.5" />
              <rect x="154" y="86" width="12" height="14" fill="#D97706" stroke="#1A202C" stroke-width="3" />
              <rect x="140" y="100" width="40" height="10" rx="3" fill="#92400E" stroke="#1A202C" stroke-width="3" />

              <!-- 3rd Place Red/Coral Pawn (Right) -->
              <circle cx="248" cy="112" r="13" fill="#EF4444" stroke="#1A202C" stroke-width="3" />
              <path d="M234 162 C236 136 241 126 248 126 C255 126 260 136 262 162 Z" fill="#EF4444" stroke="#1A202C" stroke-width="3" />
              <rect x="228" y="159" width="40" height="8" rx="4" fill="#DC2626" stroke="#1A202C" stroke-width="3" />

              <!-- Pedestal 2 (Silver/Grey) -->
              <rect x="32" y="150" width="80" height="80" rx="6" fill="#94A3B8" stroke="#1A202C" stroke-width="3" />
              <text x="72" y="198" text-anchor="middle" fill="#FFFFFF" font-family="Nunito, sans-serif" font-weight="800" font-size="28">2</text>

              <!-- Pedestal 1 (Gold) -->
              <rect x="112" y="110" width="96" height="120" rx="6" fill="#FBBF24" stroke="#1A202C" stroke-width="3" />
              <circle cx="160" cy="168" r="22" fill="#F59E0B" stroke="#FFFFFF" stroke-width="2" />
              <text x="160" y="177" text-anchor="middle" fill="#FFFFFF" font-family="Nunito, sans-serif" font-weight="800" font-size="26">1</text>

              <!-- Pedestal 3 (Bronze/Light Grey) -->
              <rect x="208" y="167" width="80" height="63" rx="6" fill="#CBD5E1" stroke="#1A202C" stroke-width="3" />
              <text x="248" y="208" text-anchor="middle" fill="#FFFFFF" font-family="Nunito, sans-serif" font-weight="800" font-size="26">3</text>
            </svg>

            <div class="podium-legend">
              <div><strong>1e:</strong> Giessen en Linge 1 (36 pt)</div>
              <div><strong>2e:</strong> Sliedrecht 1 (34 pt)</div>
              <div><strong>3e:</strong> Giessen en Linge 2 (24 pt)</div>
            </div>
          </div>

          <!-- Right: Clean Standings Table -->
          <div class="standings-table-wrap">
            <table class="standings-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Team</th>
                  <th class="num-col">Punten</th>
                  <th class="num-col">Totaal</th>
                </tr>
              </thead>
              <tbody>
                {viertallenStandings.slice(0, 7).map((row) => (
                  <tr class={row.rank <= 3 ? 'is-top-three' : ''}>
                    <td class="rank-cell">{row.rank}</td>
                    <td class="team-cell">
                      <span class="mini-board-icon" aria-hidden="true">♟</span>
                      {row.team}
                    </td>
                    <td class="num-col">{row.boardPoints}</td>
                    <td class="num-col"><strong>{row.matchPoints}</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="results-footer-link">
              <Button href="/nieuws/pentachess-viertallencompetitie-2025-2026-einduitslagen/" variant="outline-blue" size="sm" showArrow={true}>
                Bekijk volledig verslag & alle 17 teams
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Section: Archief Toernooien 2025-2026 -->
  <section class="section">
    <div class="container-narrow">
      <div class="archive-header">
        <h3 class="archive-title">Archief: Toernooien 2025-2026</h3>
        <p class="archive-desc">Terugblik op de speeldata en toernooien van het voorgaande seizoen.</p>
      </div>

      <div class="calendar-stack calendar-stack-archive">
        {calendarEvents2025_2026.map((ev) => (
          <div class="calendar-row">
            <div class="calendar-row-left">
              <span class={`event-badge badge-${ev.badgeColor}`}>{ev.badge}</span>
              <span class="event-title">
                <strong>{ev.dateLabel} – {ev.title}</strong>
              </span>
            </div>
            <div class="calendar-row-right">
              <a
                href={ev.href}
                class="btn btn-secondary btn-sm"
                {...(ev.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {ev.ctaLabel}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .section-header-block {
    text-align: center;
    margin-bottom: 2rem;
  }

  .section-badge {
    display: inline-block;
    background-color: var(--badge-blue-bg);
    color: #FFFFFF;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.75rem;
  }

  .center-badge {
    display: table;
    margin: 0 auto 1rem auto;
  }

  .section-intro {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    max-width: 650px;
    margin: 0.5rem auto 0 auto;
    line-height: 1.6;
  }

  /* Info Callout Box */
  .info-callout {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
    background: linear-gradient(135deg, #F0FDF4 0%, #FFFFFF 100%);
    border: 2px solid var(--badge-green-bg);
    border-radius: var(--radius-card);
  }

  .info-callout-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .info-callout-content {
    flex: 1;
  }

  .info-callout-title {
    font-size: 1.2rem;
    color: var(--color-primary-dark);
    margin-bottom: 0.5rem;
  }

  .info-callout-list {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
    color: var(--color-text-primary);
    font-size: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .info-callout-action {
    margin-top: 0.5rem;
  }

  /* Calendar Stack */
  .calendar-stack {
    background-color: var(--color-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    margin-bottom: 2rem;
  }

  .calendar-stack-archive {
    opacity: 0.9;
  }

  .calendar-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.15s ease;
  }

  .calendar-row:last-child {
    border-bottom: none;
  }

  .calendar-row:hover {
    background-color: #FAFCFA;
  }

  @media (min-width: 640px) {
    .calendar-row {
      flex-direction: row;
      align-items: center;
    }
  }

  .calendar-row-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .event-badge {
    display: inline-block;
    min-width: 96px;
    text-align: center;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.82rem;
    flex-shrink: 0;
  }

  .badge-green { background-color: var(--badge-green-bg); }
  .badge-blue { background-color: var(--badge-blue-bg); }
  .badge-orange { background-color: var(--badge-orange-bg); }
  .badge-pink { background-color: var(--badge-pink-bg); }
  .badge-purple { background-color: var(--badge-purple-bg); }

  .event-details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .event-title {
    font-size: 1rem;
    color: var(--color-text-primary);
  }

  .event-location {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .loc-icon {
    font-size: 0.8rem;
  }

  /* Online Banner */
  .online-banner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.75rem 2rem;
    background: linear-gradient(135deg, #EFF6FF 0%, #FFFFFF 100%);
    border: 1px solid #BFDBFE;
    border-radius: var(--radius-card);
    margin-top: 1rem;
  }

  @media (min-width: 680px) {
    .online-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .online-banner-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-secondary);
    background-color: #DBEAFE;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.4rem;
  }

  .online-banner-title {
    font-size: 1.2rem;
    margin-bottom: 0.35rem;
    color: var(--color-text-primary);
  }

  .online-banner-text {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .online-banner-action {
    flex-shrink: 0;
  }

  /* Results Card & Podium */
  .results-card {
    padding: 2.5rem 2rem;
  }

  .results-heading {
    text-align: center;
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    margin-bottom: 2rem;
  }

  .results-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 820px) {
    .results-split {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }

  .podium-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .podium-legend {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .standings-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .standings-table th {
    text-align: left;
    padding: 0.65rem 0.75rem;
    font-weight: 800;
    color: var(--color-text-secondary);
    border-bottom: 2px solid var(--color-border);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .standings-table td {
    padding: 0.7rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .standings-table tr:nth-child(even) {
    background-color: var(--color-bg-soft);
  }

  .rank-cell {
    font-weight: 800;
    width: 36px;
  }

  .team-cell {
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mini-board-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 4px;
    background-color: var(--color-border);
    font-size: 0.8rem;
  }

  .num-col {
    text-align: right !important;
  }

  .results-footer-link {
    margin-top: 1.25rem;
    text-align: right;
  }

  /* Archive */
  .archive-header {
    margin-bottom: 1rem;
  }

  .archive-title {
    font-size: 1.25rem;
    color: var(--color-text-primary);
  }

  .archive-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0.2rem 0 0 0;
  }
</style>
