---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const normalizedPath =
  currentPath.endsWith('/') && currentPath.length > 1
    ? currentPath
    : currentPath === '/'
      ? '/'
      : `${currentPath}/`;

const navItems = [
  { label: 'Home', href: '/', isActive: normalizedPath === '/' },
  { label: 'Over Ons', href: '/info/', isActive: normalizedPath.startsWith('/info/') },
  { label: 'Toernooien', href: '/toernooien/', isActive: normalizedPath.startsWith('/toernooien/') },
  { label: 'Schoolschaak', href: '/schoolschaak/', isActive: normalizedPath.startsWith('/schoolschaak/') },
  { label: 'Schaakles', href: '/schaakles/', isActive: normalizedPath.startsWith('/schaakles/') },
  {
    label: 'Nieuws',
    href: '/nieuws/',
    isActive: normalizedPath.startsWith('/nieuws/') || normalizedPath.startsWith('/author/'),
  },
];
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <a href="/" class="logo-link" rel="home" aria-label="Pentachess.nl Home">
      <img
        src="/wp-content/uploads/2020/04/pentachess_logo.png"
        alt="pentachess.nl"
        width="165"
        height="96"
        class="logo-img"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Hoofdnavigatie">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`nav-link ${item.isActive ? 'is-active' : ''}`}
              {...(item.isActive ? { 'aria-current': 'page' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile Hamburger Button -->
    <button
      type="button"
      class="mobile-menu-toggle"
      id="mobile-menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-menu-drawer"
      aria-label="Menu openen"
    >
      <svg class="icon-hamburger" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg class="icon-close" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile Collapsible Drawer -->
  <div class="mobile-drawer" id="mobile-menu-drawer" hidden>
    <nav aria-label="Mobiele navigatie" class="container mobile-drawer-inner">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={`mobile-nav-link ${item.isActive ? 'is-active' : ''}`}
              {...(item.isActive ? { 'aria-current': 'page' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--color-surface);
    box-shadow: var(--shadow-header);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 80px;
    gap: 1.5rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-img {
    height: 54px;
    width: auto;
    object-fit: contain;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 2rem;
  }

  @media (min-width: 960px) {
    .desktop-nav {
      display: flex;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text-primary);
    text-decoration: none;
    padding: 0.35rem 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-primary-green);
  }

  .nav-link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 3px;
    border-radius: 999px;
    background-color: var(--color-primary-green);
  }

  .nav-cta {
    padding: 0.6rem 1.4rem;
    font-size: 0.95rem;
  }

  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.5rem;
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .mobile-menu-toggle .icon-close {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded='true'] .icon-hamburger {
    display: none;
  }

  .mobile-menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (min-width: 960px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .mobile-drawer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
  }

  .mobile-drawer-inner {
    padding-top: 1rem;
    padding-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.65rem 0.75rem;
    border-radius: var(--radius-md);
    font-weight: 700;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    background-color: var(--color-bg-soft);
    color: var(--color-primary-green);
  }

  .mobile-cta {
    width: 100%;
    text-align: center;
  }
</style>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    if (!btn || !drawer) return;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) {
        drawer.setAttribute('hidden', '');
      } else {
        drawer.removeAttribute('hidden');
      }
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
