---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl?: string;
}

const { currentPage, totalPages, baseUrl = '/nieuws/' } = Astro.props;

function getPageUrl(p: number) {
  if (p === 1) return baseUrl;
  const base = baseUrl.endsWith('/') ? baseUrl : `${baseUrl}/`;
  return `${base}page/${p}/`;
}

const pages: (number | 'dots')[] = [];
for (let i = 1; i <= totalPages; i++) {
  if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
    pages.push(i);
  } else if (pages[pages.length - 1] !== 'dots') {
    pages.push('dots');
  }
}
---

{totalPages > 1 && (
  <nav class="pagination-nav" aria-label="Berichten paginering">
    {currentPage > 1 && (
      <a class="btn btn-outline-blue btn-sm" href={getPageUrl(currentPage - 1)}>
        &larr; Nieuwere
      </a>
    )}

    <div class="pagination-numbers">
      {pages.map((p) => {
        if (p === 'dots') return <span class="page-dots">&hellip;</span>;
        if (p === currentPage) {
          return <span aria-current="page" class="page-pill is-current">{p}</span>;
        }
        return <a class="page-pill" href={getPageUrl(p)}>{p}</a>;
      })}
    </div>

    {currentPage < totalPages && (
      <a class="btn btn-outline-blue btn-sm" href={getPageUrl(currentPage + 1)}>
        Oudere &rarr;
      </a>
    )}
  </nav>
)}

<style>
  .pagination-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 2.5rem 0;
  }

  .pagination-numbers {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .page-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-text-primary);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }

  .page-pill:hover {
    background-color: var(--color-primary-blue-light);
    color: var(--color-primary-blue);
  }

  .page-pill.is-current {
    background-color: var(--color-primary-green);
    color: #FFFFFF;
  }

  .page-dots {
    padding: 0 0.4rem;
    color: var(--color-text-secondary);
  }
</style>
